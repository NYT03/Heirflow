# ==========================================
# HeirFlow — Google Cloud Environment Configuration
# Copy values into your local .env or set in Cloud Run
# ==========================================

# Google Cloud Project Configuration
GCP_PROJECT_ID=heirflow-515305
GCP_REGION=us-central1

# Google Gemini API
# Get your API key from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Google Cloud Storage (GCS)
# Name of the GCS bucket for storing death certificates, deeds, and asset documents
GCS_BUCKET_NAME=heirflow-evidence-vault-your-project

# Google Service Account (Optional for local dev, automatic on Cloud Run)
# Path to service account JSON file if running outside GCP:
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# Server Settings
PORT=8080
JWT_SECRET=heirflow_production_jwt_secret_change_me
NODE_ENV=production

